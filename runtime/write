BASE_ADDR=0x2000
        REG_START=$((BASE_ADDR + 4 * 0))
   REG_HSI_SELECT=$((BASE_ADDR + 4 * 1))
  REG_FORCE_CACHE=$((BASE_ADDR + 4 * 2))
 REG_ROWS_UPDATED=$((BASE_ADDR + 4 * 3))
REG_WORDS_UPDATED=$((BASE_ADDR + 4 * 4))


axi()
{
    axireg $1 $2 $3 $4    
}



bus_type=

# Did the user select "Update SMEM via SPI"?
if [ "$1" == "0" ] || [ "$1" == "spi" ]; then
    bus_type=0
    shift
fi
# Did the user select "Update SMEM via HSI"?
if [ "$1" == "1" ] || [ "$1" == "hsi" ]; then
    bus_type=1
    shift
fi

# Make sure the user gave us a bus-type
if [ -z bus_type ]; then
    echo "Must specify bus type spi or hsi"
    exit 1
fi



# Does the user want to force all rows of SMEM/cache to be updated?
force_smem=0
if [ "$1" == "1" ] || [ "$1" == "force" ]; then
    force_smem=1
    shift
fi

# This signal is rising-edge sensitive
axi $REG_FORCE_CACHE $force_smem
axi $REG_FORCE_CACHE 0

# Writing a 1 here selects the HSI bus.  A 0 selects the SPI bus     
axi $REG_HSI_SELECT  $bus_type 
axi $REG_START       1
sleep 1

echo " SMEM rows updated: $(axi -dec $REG_ROWS_UPDATED )"
echo "SMEM words updated: $(axi -dec $REG_WORDS_UPDATED)"


